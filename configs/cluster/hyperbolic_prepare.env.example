# One-node RoboTwin preprocessing environment for run_hyperbolic_container.sh.
# Copy outside Git and keep the canonical preparation node at rank 0.

export NODE_RANK=0
export GENET_CONTAINER_NAME=genet-preprocess
export GENET_NODE_CACHE=/mnt/nvme/mds-cache/robotwin_v1
export GENET_NODE_RUN_ROOT=/mnt/nvme/genet

# Streaming may lazily materialize compressed MDS shards, and preprocessing
# writes the completed GenET tree below GENET_NODE_CACHE.
export GENET_CACHE_READONLY=0
export GENET_PROTECT_INPUTS=0
export GENET_IMAGE_PULL_POLICY=missing
