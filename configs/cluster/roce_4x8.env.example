# Copy this file outside Git or source it from the scheduler prologue.
# Values are examples only; discover the actual interfaces with ibdev2netdev
# and show_gids on every node.

export NNODES=4
export NPROC_PER_NODE=8
export MASTER_ADDR=10.0.0.10
export MASTER_PORT=29500
export PREFLIGHT_PORT=29499
export GENET_PREFLIGHT_TIMEOUT_SECONDS=120

# Reproducibility contract. Replace every placeholder with the value produced
# by the release/staging job. The launch script and training preflight fail
# before optimizer steps if these identities are missing or differ by rank.
export GENET_STRICT_ENV=1
export GENET_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
export GENET_CODE_REVISION=REPLACE_WITH_GENET_GIT_SHA
export GENET_COSMOS_REVISION=a904d2d36b774a51dd06ff9ff906816b1a04f579
export GENET_CLUSTER_LOCK=/local_nvme/genet/release/cluster-lock.json
export GENET_CLUSTER_RECEIPT=/local_nvme/genet/release/node-receipt.json
export GENET_HF_SNAPSHOT_REVISION=REPLACE_WITH_COSMOS3_EDGE_HF_COMMIT_SHA
export GENET_DATA_ARTIFACT=processed_data
export GENET_WAN_VAE_ARTIFACT=wan_vae
export GENET_CHECKPOINT_ARTIFACT=training_checkpoint
export GENET_HF_ARTIFACT=hf_cache
export WAN_VAE_PATH=/local_nvme/genet/checkpoints/wan22_vae/Wan2.2_VAE.pth
export HF_HOME=/local_nvme/genet/hf-cache

# Keep model/tokenizer resolution local after all artifacts have been staged.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Ethernet bootstrap interface (not necessarily the RDMA HCA).
export NCCL_SOCKET_IFNAME=eno1
export GLOO_SOCKET_IFNAME=eno1

# Comma-separated RDMA HCAs, optionally excluding unused ports with ^.
export NCCL_IB_HCA=mlx5_0,mlx5_1
export NCCL_IB_DISABLE=0

# Let NCCL >= 2.21 dynamically select a RoCE GID. Set NCCL_IB_GID_INDEX only
# on older NCCL after checking show_gids and confirming the RoCEv2 index.
# export NCCL_IB_GID_INDEX=3

export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,NET,ENV

# TC/SL/GDR settings depend on the fabric's PFC/ECN design. Do not copy values
# from another cluster; validate with the administrator and nccl-tests.
# export NCCL_IB_TC=106
# export NCCL_IB_SL=3
# export NCCL_NET_GDR_LEVEL=PHB
