# One-node canonical release-lock creation environment.
# Per-node receipt creation is fanned out later by launch_cluster_ssh.sh.

export NODE_RANK=0
export GENET_CONTAINER_NAME=genet-lock-create
export GENET_NODE_CACHE=/mnt/nvme/mds-cache/robotwin_v1
export GENET_NODE_RUN_ROOT=/mnt/nvme/genet
export GENET_CACHE_READONLY=1
export GENET_PROTECT_INPUTS=0
export GENET_IMAGE_PULL_POLICY=missing

export GENET_RELEASE_ID=REPLACE_WITH_RELEASE_ID
export GENET_RELEASE_DIR=/mnt/nvme/genet/release/REPLACE_WITH_RELEASE_ID
export GENET_PROCESSED_DATA=/mnt/nvme/mds-cache/robotwin_v1/genet/processed/train
