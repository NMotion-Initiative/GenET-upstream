# Shared job environment for scripts/launch_cluster_ssh.sh.
# Copy outside Git, replace every placeholder, and keep NODE_RANK unset: the
# launcher assigns it from hostfile order. This is shell syntax, not a Docker
# --env-file.

export NNODES=4
export NPROC_PER_NODE=8
export MASTER_ADDR=REPLACE_WITH_RANK0_PRIVATE_BOOTSTRAP_IP
export MASTER_PORT=29500
export PREFLIGHT_PORT=29499
export GENET_PREFLIGHT_TIMEOUT_SECONDS=120

# Hyperbolic node-local storage. The same path exists independently on every
# node. Training mounts the warmed data cache read-only and the job root read-write.
export GENET_NVME_ROOT=/mnt/nvme
export GENET_NODE_CACHE=/mnt/nvme/mds-cache/robotwin_v1
export GENET_NODE_RUN_ROOT=/mnt/nvme/genet
export GENET_PROCESSED_DATA=/mnt/nvme/mds-cache/robotwin_v1/genet/processed/train
export GENET_MANIFEST=/mnt/nvme/mds-cache/robotwin_v1/genet/processed/train/manifest.jsonl
export GENET_EXPECTED_GPUS=8
export GENET_CACHE_READONLY=1
export GENET_IMAGE_PULL_POLICY=missing

# Reproducibility contract. GENET_IMAGE_DIGEST is derived from the --image
# reference by run_hyperbolic_container.sh; all other placeholders are required.
export GENET_STRICT_ENV=1
export GENET_CODE_REVISION=REPLACE_WITH_FULL_GENET_GIT_SHA
export GENET_COSMOS_REVISION=a904d2d36b774a51dd06ff9ff906816b1a04f579
export GENET_CLUSTER_LOCK=/mnt/nvme/genet/release/REPLACE_WITH_RELEASE_ID/cluster-lock.json
export GENET_CLUSTER_RECEIPT=/mnt/nvme/genet/release/REPLACE_WITH_RELEASE_ID/node-receipt.json
export GENET_HF_SNAPSHOT_REVISION=REPLACE_WITH_FULL_COSMOS3_EDGE_HF_SHA

export GENET_DATA_ARTIFACT=processed_data
export GENET_WAN_VAE_ARTIFACT=wan_vae
export GENET_CHECKPOINT_ARTIFACT=training_checkpoint
export GENET_HF_ARTIFACT=hf_cache

export BASE_CHECKPOINT_PATH=/mnt/nvme/genet/checkpoints/Cosmos3-Edge
export WAN_VAE_PATH=/mnt/nvme/genet/artifacts/wan22_vae/Wan2.2_VAE.pth
export HF_HOME=/mnt/nvme/genet/hf-cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Discover these on every allocated node. Do not copy names or QoS values from
# another cluster. MASTER_ADDR must be reachable through this bootstrap path.
export NCCL_SOCKET_IFNAME=REPLACE_WITH_BOOTSTRAP_INTERFACE
export GLOO_SOCKET_IFNAME=REPLACE_WITH_BOOTSTRAP_INTERFACE
export NCCL_IB_HCA=REPLACE_WITH_COMMA_SEPARATED_HCAS
export NCCL_IB_DISABLE=0

# With NCCL >= 2.21, prefer dynamic RoCE GID selection. Set a GID index only
# when the installed NCCL and the provider's fabric configuration require it.
# export NCCL_IB_GID_INDEX=REPLACE_AFTER_SHOW_GIDS

export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,NET,ENV
