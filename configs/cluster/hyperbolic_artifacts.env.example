# One-node checkpoint staging environment for run_hyperbolic_container.sh.
# Supply HF_TOKEN only when access policy requires it, then unset it immediately.

export NODE_RANK=0
export GENET_CONTAINER_NAME=genet-artifact-stage
export GENET_NODE_CACHE=/mnt/nvme/mds-cache/robotwin_v1
export GENET_NODE_RUN_ROOT=/mnt/nvme/genet
export GENET_CACHE_READONLY=1
export GENET_PROTECT_INPUTS=0
export GENET_IMAGE_PULL_POLICY=missing

export HF_HOME=/mnt/nvme/genet/hf-cache
export GENET_ALLOW_HF_TOKEN=1
# export HF_TOKEN=REPLACE_WITH_EPHEMERAL_READ_TOKEN
